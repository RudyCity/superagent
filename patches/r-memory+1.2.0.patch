+    exec(sql) {
+      this.db.run(sql);
+    }
+    pragma(sql) {
+      this.db.run(`PRAGMA ${sql}`);
+    }
+    prepare(sql) {
+      const query = this.db.query(sql);
+      return {
+        get(...args) {
+          const res = query.get(...args);
+          return res === null ? undefined : res;
+        },
+        run(...args) {
+          return query.run(...args);
+        },
+        all(...args) {
+          return query.all(...args);
+        }
+      };
+    }
+  };
