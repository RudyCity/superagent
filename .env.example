# === SuperAgent Environment Variables ===
# Most configuration (providers, API keys, models, settings) is now stored
# in ~/.superagent-r/model-config.json and managed via slash commands:
#   /login     - Configure provider profiles and API keys
#   /model     - Set active AI models per tier
#   /settings  - View/configure rate limits, concurrency, streaming, etc.
#
# The variables below are optional runtime overrides.

# === Runtime Mode ===
# Set to "true" to enable multi-agent mode (master + superagent + subagents).
# Can also be passed as --multi CLI flag.
# SUPERAGENT_MULTI=false

# === Global Model Override ===
# Override ALL tier models with a single model. Format: "provider:model" or just "model".
# Examples: "openai:gpt-4o", "anthropic:claude-3-5-sonnet", "openrouter:google/gemini-2.5-flash"
# This takes priority over per-tier model configuration in model-config.json.
# MODEL=gpt-4o

# === Session Isolation ===
# Namespace the config directory for parallel sessions (e.g. multiple terminals).
# SUPERAGENT_SESSION_ID=

# === Examples of endpoint URLs (for reference) ===
# Ollama:     http://localhost:11434/v1
# LM Studio:  http://localhost:1234/v1
# vLLM:       http://localhost:8000/v1
# LiteLLM:    http://localhost:4000/v1
