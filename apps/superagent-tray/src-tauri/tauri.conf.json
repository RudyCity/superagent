{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperAgent Tray",
  "version": "0.1.0",
  "identifier": "click.superagent.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperAgent Tray · Cron & Runtime",
        "decorations": false,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "width": 1070,
        "height": 760,
        "minWidth": 760,
        "minHeight": 530,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
