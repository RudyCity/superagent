{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperAgent",
  "version": "1.14.87",
  "identifier": "click.superagent.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperAgent · Runtime & Desktop Companion",
        "decorations": false,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "maximized": true,
        "width": 1070,
        "height": 760,
        "minWidth": 760,
        "minHeight": 530,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; script-src 'self'; style-src 'self'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../../dist/**/*",
      "../../../package.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "nsis_hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libappindicator3-1 | libayatana-appindicator3-1"
        ]
      }
    }
  }
}
