{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperAgent LAN Client",
  "version": "0.2.0",
  "identifier": "click.superagent.lanclient",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SuperAgent LAN Client",
        "width": 1140,
        "height": 780,
        "minWidth": 840,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost https://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "resources/superagent-lan-client.exe": "binaries/superagent-lan-client.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
