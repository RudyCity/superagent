{
  "manifest_version": 3,
  "name": "Superagent Remote Bridge",
  "version": "1.0.0",
  "description": "Standalone lightweight remote control extension for Superagent CLI without requiring local server or sidepanel GUI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "cookies",
    "webNavigation",
    "bookmarks",
    "history",
    "downloads",
    "alarms",
    "notifications",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Superagent Remote Bridge Status"
  }
}
