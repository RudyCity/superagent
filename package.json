{
  "name": "superagent",
  "version": "1.5.43",
  "description": "Interactive terminal-based AI coding assistant",
  "type": "module",
  "bin": {
    "superagent": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.tsx",
    "prebuild": "node -e \"const p=require('./package.json');console.log('Building ' + p.name + '@' + p.version)\"",
    "build": "tsc",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "verify:extension-js": "node scripts/verify-extension-js.mjs",
    "verify:all": "bun run build && bun run verify:extension-js && bun run test",
    "ext:css": "tailwindcss -i chrome-extension/sidepanel.src.css -o chrome-extension/sidepanel.css",
    "ext:css:watch": "tailwindcss -i chrome-extension/sidepanel.src.css -o chrome-extension/sidepanel.css --watch",
    "postinstall": "bun x patch-package",
    "wiki:serve": "bun --bun x serve docs/wiki -p 3333",
    "wiki:sync": "node .agents/skills/codebase-wiki-generator/scripts/sync-wiki-on-change.cjs",
    "wiki:watch": "node .agents/skills/codebase-wiki-generator/scripts/watch-and-sync.cjs",
    "wiki:validate": "node .agents/skills/codebase-wiki-generator/scripts/validate-wiki-links.cjs --wiki-dir docs/wiki"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/azure": "^1.3.25",
    "@ai-sdk/deepseek": "^0.2.16",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/mistral": "^1.2.8",
    "@ai-sdk/openai": "^1.3.23",
    "@ai-sdk/xai": "^1.2.18",
    "@modelcontextprotocol/sdk": "^1.4.0",
    "@xenova/transformers": "^2.17.2",
    "ai": "^4.3.16",
    "execa": "^9.5.2",
    "fast-glob": "^3.3.3",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "r-memory": "git+https://github.com/RudyCity/r-memory.git",
    "react": "^18.3.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "tiktoken": "^1.0.22",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.2",
    "@tailwindcss/cli": "^4.3.2",
    "@types/node": "^22.15.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.20",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  }
}
