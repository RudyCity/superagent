{
  "name": "superagent",
  "version": "1.14.77",
  "description": "Terminal-native general-purpose AI assistant for research, writing, productivity, automation and software development",
  "type": "module",
  "bin": {
    "superagent": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun src/cli.tsx",
    "prebuild": "bun -e \"const p=require('./package.json');console.log('Building '+p.name+'@'+p.version+' with Bun '+Bun.version)\"",
    "build": "bun --bun x tsc",
    "sync-mcp": "bun scripts/syncMcpSchemas.ts",
    "postbuild": "bun scripts/syncMcpSchemas.ts && bun scripts/write-core-build-manifest.ts",
    "start": "bun dist/cli.js",
    "test": "bun --bun x vitest run",
    "test:unit": "bun --bun x vitest run --maxWorkers=4 --exclude \"**/*integration*\" --exclude \"**/*Integration*\" --exclude \"**/*e2e*\" --exclude \"**/*E2E*\"",
    "test:integration": "bun --bun x vitest run tests/*integration*.test.ts tests/*Integration*.test.ts",
    "verify:extension-js": "bun scripts/verify-extension-js.mjs",
    "verify:delegate": "bun --bun x tsc --noEmit && bun run verify:extension-js && bun --bun x vitest run tests/delegate.test.ts tests/delegateContent.test.ts tests/delegateMultiClient.test.ts tests/delegateStatus.test.ts tests/delegateTabSingleton.test.ts tests/delegateMcpExposure.test.ts tests/delegateMcpHostRoute.test.ts tests/delegateForwardedPrincipal.test.ts tests/delegateForwardedHostDispatch.test.ts tests/delegateForwardingLifecycle.test.ts tests/delegateCoreEndpoint.test.ts tests/delegateSemanticTabAffinity.test.ts tests/delegateHistorySyncFallback.test.ts tests/delegateCdpHistoryRead.test.ts tests/delegateChatConfiguration.test.ts tests/extensionChatToolFilter.test.ts && bun scripts/verify-delegate-discovery.ts",
    "release:delegate": "bun scripts/release-delegate.mjs",
    "delegate:pairing": "bun scripts/delegate-auth.mjs status",
    "verify:all": "bun run build && bun run verify:extension-js && bun run test",
    "ext:css": "bun scripts/build-extension-css.ts",
    "ext:css:watch": "bun scripts/build-extension-css.ts --watch",
    "wiki:serve": "bun --bun x serve docs/wiki -p 3333",
    "wiki:sync": "bun .agents/skills/codebase-wiki-generator/scripts/sync-wiki-on-change.cjs",
    "wiki:watch": "bun .agents/skills/codebase-wiki-generator/scripts/watch-and-sync.cjs",
    "wiki:validate": "bun .agents/skills/codebase-wiki-generator/scripts/validate-wiki-links.cjs --wiki-dir docs/wiki",
    "runtime:smoke": "bun scripts/bun-runtime-smoke.ts",
    "verify:runtime": "bun run build && bun run runtime:smoke",
    "runtime:acceptance": "bun scripts/bun-acceptance.ts",
    "perf:bun": "bun scripts/bench-bun-runtime.ts",
    "security:bun": "bun scripts/check-bun-security.ts",
    "tray:check": "cargo check --manifest-path apps/superagent-tray/src-tauri/Cargo.toml",
    "tray:test": "cargo test --manifest-path apps/superagent-tray/src-tauri/Cargo.toml",
    "tray:build": "bun x @tauri-apps/cli build --config apps/superagent-tray/src-tauri/tauri.conf.json",
    "tray:prebuilt:check": "bun scripts/install-prebuilt-windows.ts --check",
    "tray:prebuilt:download": "bun scripts/install-prebuilt-windows.ts --download",
    "tray:prebuilt:install": "bun scripts/install-prebuilt-windows.ts --install",
    "installer:prepare": "bun scripts/prepare-standalone-windows.ts",
    "installer:verify": "bun scripts/verify-standalone-windows.ts",
    "installer:package": "bun scripts/build-standalone-windows.ts",
    "installer:prepare:unix": "bun scripts/prepare-standalone-unix.ts",
    "installer:verify:unix": "bun scripts/verify-standalone-unix.ts",
    "installer:package:unix": "bun scripts/build-standalone-unix.ts",
    "installer:build:unix": "bun run build && cargo build --release --bin superagent --manifest-path apps/superagent-tray/src-tauri/Cargo.toml && bun run installer:prepare:unix && bun run installer:verify:unix && bun run installer:package:unix",
    "installer:build": "bun run build && cargo build --release --bin superagent --manifest-path apps/superagent-tray/src-tauri/Cargo.toml && bun run installer:prepare && bun run installer:verify && bun run installer:package",
    "integration:tline": "bun scripts/bun-tline-bridge-smoke.ts",
    "compat:bun": "bun scripts/bun-dependency-compat-smoke.ts",
    "doctor:launcher": "bun scripts/repair-bun-global-launcher.ts",
    "repair:launcher": "bun scripts/repair-bun-global-launcher.ts --apply",
    "setup:piper": "bun scripts/setup-piper.ts",
    "test:e2e": "bun --bun x vitest run tests/*e2e*.test.ts tests/*E2E*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/azure": "^1.3.25",
    "@ai-sdk/deepseek": "^0.2.16",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/mistral": "^1.2.8",
    "@ai-sdk/openai": "^1.3.23",
    "@ai-sdk/xai": "^1.2.18",
    "@e965/xlsx": "^0.20.3",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.2",
    "@novnc/novnc": "^1.7.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@signpdf/placeholder-pdf-lib": "4.0.0",
    "@signpdf/signer-p12": "4.0.0",
    "@signpdf/signpdf": "4.0.0",
    "@signpdf/utils": "4.0.0",
    "ai": "^4.3.16",
    "execa": "^9.5.2",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "mammoth": "^1.12.0",
    "node-forge": "1.4.3",
    "onnxruntime-node": "^1.14.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "1.56.1",
    "qrcode": "1.5.4",
    "r-memory": "git+https://github.com/RudyCity/r-memory.git#64c718ce05c103a2d4e6218505279d990b55488f",
    "react": "^18.3.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "tiktoken": "^1.0.22",
    "tokenizers": "0.23.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "^22.15.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.20",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.1",
    "jszip": "3.10.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "zod": "4.6.7",
    "@xmldom/xmldom": "0.9.12",
    "fast-uri": "3.1.7",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "tar": "7.5.22",
    "ip-address": "10.7.4",
    "nanoid": "3.3.18",
    "vite": "8.3.5",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "jsondiffpatch": "0.7.6",
    "sharp": "0.35.5",
    "node-forge": "1.4.3"
  },
  "patchedDependencies": {
    "ink-text-input@6.0.0": "patches/ink-text-input@6.0.0.patch",
    "mammoth@1.12.0": "patches/mammoth@1.12.0.patch"
  },
  "trustedDependencies": [
    "r-memory"
  ]
}
