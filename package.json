{
  "name": "superagent",
  "version": "1.14.11",
  "description": "Terminal-native general-purpose AI assistant for research, writing, productivity, automation and software development",
  "type": "module",
  "bin": {
    "superagent": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun src/cli.tsx",
    "prebuild": "bun -e \"const p=require('./package.json');console.log('Building '+p.name+'@'+p.version+' with Bun '+Bun.version)\"",
    "build": "bun --bun x tsc",
    "sync-mcp": "bun scripts/syncMcpSchemas.ts",
    "postbuild": "bun scripts/syncMcpSchemas.ts",
    "start": "bun dist/cli.js",
    "test": "bun --bun x vitest run",
    "test:unit": "bun --bun x vitest run --exclude \"**/*integration*\" --exclude \"**/*e2e*\"",
    "test:integration": "bun --bun x vitest run tests/*integration*.test.ts",
    "verify:extension-js": "bun scripts/verify-extension-js.mjs",
    "verify:all": "bun run build && bun run verify:extension-js && bun run test",
    "ext:css": "bun scripts/build-extension-css.ts",
    "ext:css:watch": "bun scripts/build-extension-css.ts --watch",
    "wiki:serve": "bun --bun x serve docs/wiki -p 3333",
    "wiki:sync": "bun .agents/skills/codebase-wiki-generator/scripts/sync-wiki-on-change.cjs",
    "wiki:watch": "bun .agents/skills/codebase-wiki-generator/scripts/watch-and-sync.cjs",
    "wiki:validate": "bun .agents/skills/codebase-wiki-generator/scripts/validate-wiki-links.cjs --wiki-dir docs/wiki",
    "runtime:smoke": "bun scripts/bun-runtime-smoke.ts",
    "verify:runtime": "bun run build && bun run runtime:smoke",
    "runtime:acceptance": "bun scripts/bun-acceptance.ts",
    "perf:bun": "bun scripts/bench-bun-runtime.ts",
    "security:bun": "bun scripts/check-bun-security.ts",
    "integration:tline": "bun scripts/bun-tline-bridge-smoke.ts",
    "compat:bun": "bun scripts/bun-dependency-compat-smoke.ts",
    "doctor:launcher": "bun scripts/repair-bun-global-launcher.ts",
    "repair:launcher": "bun scripts/repair-bun-global-launcher.ts --apply"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/azure": "^1.3.25",
    "@ai-sdk/deepseek": "^0.2.16",
    "@ai-sdk/google": "^1.2.22",
    "@ai-sdk/groq": "^1.2.9",
    "@ai-sdk/mistral": "^1.2.8",
    "@ai-sdk/openai": "^1.3.23",
    "@ai-sdk/xai": "^1.2.18",
    "@e965/xlsx": "^0.20.3",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "^1.0.2",
    "ai": "^4.3.16",
    "execa": "^9.5.2",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "mammoth": "^1.12.0",
    "onnxruntime-node": "^1.14.0",
    "pdf-parse": "^2.4.5",
    "r-memory": "git+https://github.com/RudyCity/r-memory.git#2b5de65a1aa8ece0998e3411c07a22c2b41b2713",
    "react": "^18.3.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1",
    "tiktoken": "^1.0.22",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@tailwindcss/node": "4.3.3",
    "@tailwindcss/oxide": "4.3.3",
    "@types/node": "^22.15.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.20",
    "@types/ssh2": "^1.15.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "fast-uri": "3.1.7",
    "proxy-addr": "2.0.8",
    "source-map-js": "1.2.2",
    "tar": "7.5.22",
    "ip-address": "10.7.4",
    "nanoid": "3.3.18",
    "vite": "8.3.5",
    "xlsx": "npm:@e965/xlsx@0.20.3",
    "jsondiffpatch": "0.7.6",
    "sharp": "0.35.5"
  },
  "patchedDependencies": {
    "ink-text-input@6.0.0": "patches/ink-text-input@6.0.0.patch",
    "mammoth@1.12.0": "patches/mammoth@1.12.0.patch"
  },
  "trustedDependencies": [
    "r-memory"
  ]
}
