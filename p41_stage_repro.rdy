# Task 41 repro: string literals containing slash-star are NOT mangled
# =============================================================================
# Investigation finding (2026-10-27): a Task 40-era session observed
#   print('[' + 'a /* b' + ']')  ->  [a /*b]
# i.e. an apparent "space swallow" inside string literals containing /*.
# Cross-examination on every surviving binary (script file / -c / stdin
# paths, single + double quotes) plus a byte-level trace (lexer token ->
# string() escape processing -> takeString) shows the whole chain is
# intact:
#   len('/* b')   == 4   (/ * SPACE b)
#   len('a /* b') == 6   (a SPACE / * SPACE b)
# The earlier observation is attributed to the corrupted incremental
# build produced by the Task 40 build race (MSB6003/MSB3491 tlog lock
# collisions), not to source code - no surviving binary reproduces it,
# and the original expectations were character miscounts besides.
# This repro pins the correct semantics so any recurrence is caught
# immediately. No compiler/lexer/runtime change was needed.
# =============================================================================

ok = 0
total = 0

def check(name, cond):
    global ok, total
    total = total + 1
    if cond:
        ok = ok + 1
        print("PASS:", name)
    else:
        print("FAIL:", name)

# --- 1. exact character counts ------------------------------------------------
check("len('/* b') == 4", len('/* b') == 4)
check("len('a /* b') == 6", len('a /* b') == 6)
check("len('a /*b') == 5", len('a /*b') == 5)
check("len('a / b') == 5", len('a / b') == 5)
check("len('xy /*') == 5", len('xy /*') == 5)

# --- 2. content preservation (both quote styles, variable roundtrip) -----------
t = 'a /* b'
check("variable roundtrip", t == 'a /* b')
check("double == single quote", "a /* b" == 'a /* b')
check("concat identity", '[' + 'a /* b' + ']' == '[a /* b]')

# --- 3. edge shapes -------------------------------------------------------------
check("leading slash-star", len('/* x') == 4)
check("build star-slash by concat", 'xy ' + '/*' == 'xy /*')
check("doubled slash-star", len('/* /*') == 5)
check("spaces around slash-star", len(' /* ') == 4)

# --- 4. escape-built / * SPACE are not second-guessed ---------------------------
check("escape builds slash", len('\x2f* b') == 4)
check("escape builds star", len('/\x2a b') == 4)
check("escape builds space", len('a\x20/* b') == 6)

# --- 5. block comments still work OUTSIDE strings (Task 40 interplay) -----------
z = 1 /* comment, not string */ + 2
check("block comment outside string", z == 3)

print("SUMMARY:", ok, "/", total)
assert ok == total
