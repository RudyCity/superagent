# Git worktrees
.worktrees/

# Node.js dependencies (run: npm install)
node_modules/

# TypeScript build output (run: npm run build)
dist/

# Portable Python bundled for fastcontext (run: .\bin\setup-fastcontext.ps1)
bin/python/

# FastContext source (cloned by setup script)
vendor/fastcontext/

# TencentDB Memory Gateway (cloned automatically at runtime by tencentdbSetup.ts)
vendor/tencentdb-memory/

# Superagent runtime directory
.superagent-r/

# Environment & secrets
.env
.env.local

# OS & editor files
.DS_Store
Thumbs.db
*.log
